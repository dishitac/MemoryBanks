# Copy to .env and fill in. Never commit .env (this repo is public).

# MongoDB Atlas: must be the cluster created in the hackathon Atlas Sandbox.
# Same format for everyone: mongodb+srv://<user>:<password>@<cluster-host>/
# URL-encode special characters in the password (@ -> %40, / -> %2F, : -> %3A).
# Share the real value privately (not in git, issues or chat logs).
MONGODB_URI=
MONGODB_DB=memorybank

# Voyage AI embeddings. EMBEDDING_DIM must match the Vector Search index dimensions.
VOYAGE_API_KEY=
# Use a model with free tokens on your Voyage dashboard (voyage-4 family). voyage-3.5 is NOT free.
VOYAGE_MODEL=voyage-4
EMBEDDING_DIM=1024

# LLM used for the structured routing action (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Services
TICKET_SERVICE_URL=http://localhost:8001
API_PORT=8000

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
